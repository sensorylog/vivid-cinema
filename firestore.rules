// Vivid Cinema Firestore rules: deploy this file to the live Firebase project when changed.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVividUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isRoomMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return isVividUser()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
        && room.status == 'open'
        && room.keys().hasAll(['expiresAt'])
        && room.expiresAt is timestamp
        && room.expiresAt > request.time;
    }

    function isClubMember(clubId) {
      return isVividUser()
        && exists(/databases/$(database)/documents/cinemaClubs/$(clubId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/cinemaClubs/$(clubId)).data.status == 'active';
    }

    function validContentId(contentId) {
      return contentId.matches('^(movie|tv):[0-9]+$');
    }

    function validProgressId(contentId) {
      return contentId.matches('^movie:[0-9]+$')
        || contentId.matches('^tv:[0-9]+$')
        || contentId.matches('^tv:[0-9]+:[0-9]+:[0-9]+$');
    }

    function validLibraryData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','title','year','poster_path','backdrop_path','updatedAt',
        'startedAt','lastWatchedAt','watchedSeconds','completion','completedAt','isAnime'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.matches('^[0-9]+$')
      && request.resource.data.media_type in ['movie', 'tv']
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 300
      && request.resource.data.year is string
      && request.resource.data.year.size() <= 10
      && request.resource.data.poster_path is string
      && request.resource.data.poster_path.size() <= 500
      && request.resource.data.backdrop_path is string
      && request.resource.data.backdrop_path.size() <= 500
      && (!request.resource.data.keys().hasAny(['updatedAt']) || (request.resource.data.updatedAt is number && request.resource.data.updatedAt >= 0))
      && (!request.resource.data.keys().hasAny(['startedAt']) || (request.resource.data.startedAt is number && request.resource.data.startedAt >= 0))
      && (!request.resource.data.keys().hasAny(['lastWatchedAt']) || (request.resource.data.lastWatchedAt is number && request.resource.data.lastWatchedAt >= 0))
      && (!request.resource.data.keys().hasAny(['watchedSeconds']) || (request.resource.data.watchedSeconds is number && request.resource.data.watchedSeconds >= 0 && request.resource.data.watchedSeconds <= 10000000))
      && (!request.resource.data.keys().hasAny(['completion']) || (
        request.resource.data.completion is number &&
        request.resource.data.completion >= 0 &&
        request.resource.data.completion <= 100
      ))
      && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is number)
      && (!request.resource.data.keys().hasAny(['isAnime']) || request.resource.data.isAnime is bool);
    }

    function validProgressData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','progress','duration','percentage','completed','completedAt',
        'season','episode','title','updatedAt','isAnime'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.matches('^[0-9]+$')
      && request.resource.data.media_type in ['movie','tv']
      && request.resource.data.progress is number
      && request.resource.data.progress >= 0
      && request.resource.data.progress <= 10000000
      && request.resource.data.duration is number
      && request.resource.data.duration >= 0
      && request.resource.data.duration <= 10000000
      && request.resource.data.percentage is number
      && request.resource.data.percentage >= 0
      && request.resource.data.percentage <= 100
      && request.resource.data.completed is bool
      && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is number)
      && (!request.resource.data.keys().hasAny(['season']) || request.resource.data.season == null || request.resource.data.season is number)
      && (!request.resource.data.keys().hasAny(['episode']) || request.resource.data.episode == null || request.resource.data.episode is number)
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 300
      && (!request.resource.data.keys().hasAny(['isAnime']) || request.resource.data.isAnime is bool)
      && request.resource.data.updatedAt is number;
    }

    function validAnimePreferences() {
      return request.resource.data.keys().hasOnly(['track','autoplayNextEpisode','subtitleLanguage','preferredPlayer','updatedAt'])
        && request.resource.data.track in ['sub','dub']
        && request.resource.data.autoplayNextEpisode is bool
        && request.resource.data.subtitleLanguage is string
        && request.resource.data.subtitleLanguage.size() <= 12
        && request.resource.data.preferredPlayer is string
        && request.resource.data.preferredPlayer.size() <= 32
        && request.resource.data.updatedAt is number
        && request.resource.data.updatedAt >= 0;
    }

    function validTombstoneData() {
      return request.resource.data.keys().hasOnly(['collection','contentId','deletedAt'])
      && request.resource.data.collection in ['favorites','watchLater','history','completed']
      && request.resource.data.contentId is string
      && request.resource.data.contentId.matches('^(movie|tv):[0-9]+$')
      && request.resource.data.deletedAt is number;
    }

    function validFeedbackData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','title','year','poster_path','backdrop_path','kind','updatedAt'
      ])
      && request.resource.data.kind in ['like','not_for_me','cleared']
      && request.resource.data.updatedAt is number
      && (!request.resource.data.keys().hasAny(['id']) || request.resource.data.id.matches('^[0-9]+$'))
      && (!request.resource.data.keys().hasAny(['media_type']) || request.resource.data.media_type in ['movie','tv'])
      && (!request.resource.data.keys().hasAny(['title']) || (request.resource.data.title is string && request.resource.data.title.size() <= 300))
      && (!request.resource.data.keys().hasAny(['year']) || request.resource.data.year is string)
      && (!request.resource.data.keys().hasAny(['poster_path']) || request.resource.data.poster_path is string)
      && (!request.resource.data.keys().hasAny(['backdrop_path']) || request.resource.data.backdrop_path is string);
    }

    function validEventData() {
      return request.resource.data.keys().hasOnly([
        'id','type','contentId','mediaType','occurredAt','sessionId','metadata'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() <= 100
      && request.resource.data.type is string
      && request.resource.data.type.size() >= 1
      && request.resource.data.type.size() <= 60
      && request.resource.data.occurredAt is number
      && request.resource.data.sessionId is string
      && request.resource.data.sessionId.size() <= 100
      && (!request.resource.data.keys().hasAny(['contentId']) || request.resource.data.contentId == null || request.resource.data.contentId.matches('^(movie|tv):[0-9]+$'))
      && (!request.resource.data.keys().hasAny(['mediaType']) || request.resource.data.mediaType == null || request.resource.data.mediaType in ['movie','tv'])
      && (!request.resource.data.keys().hasAny(['metadata']) || (request.resource.data.metadata is map && request.resource.data.metadata.keys().size() <= 20));
    }

    function validTasteData() {
      return request.resource.data.keys().hasOnly([
        'version','genres','languages','countries','actors','directors','media','decades','updatedAt','onboarding'
      ])
      && request.resource.data.version is number
      && request.resource.data.version >= 1
      && request.resource.data.version <= 10
      && request.resource.data.genres is map && request.resource.data.genres.keys().size() <= 100
      && request.resource.data.languages is map && request.resource.data.languages.keys().size() <= 100
      && request.resource.data.countries is map && request.resource.data.countries.keys().size() <= 100
      && request.resource.data.actors is map && request.resource.data.actors.keys().size() <= 100
      && request.resource.data.directors is map && request.resource.data.directors.keys().size() <= 100
      && request.resource.data.media is map && request.resource.data.media.keys().size() <= 100
      && request.resource.data.decades is map && request.resource.data.decades.keys().size() <= 100
      && request.resource.data.updatedAt is number
      && (!request.resource.data.keys().hasAny(['onboarding']) ||
        (request.resource.data.onboarding is map
          && request.resource.data.onboarding.keys().hasOnly(['shownAt','completed','dismissed','completedAt'])
          && (!request.resource.data.onboarding.keys().hasAny(['shownAt']) || request.resource.data.onboarding.shownAt is number)
          && (!request.resource.data.onboarding.keys().hasAny(['completedAt']) || request.resource.data.onboarding.completedAt is number)
          && (!request.resource.data.onboarding.keys().hasAny(['completed']) || request.resource.data.onboarding.completed is bool)
          && (!request.resource.data.onboarding.keys().hasAny(['dismissed']) || request.resource.data.onboarding.dismissed is bool)));
    }

    function validPushSubscription() {
      return request.resource.data.keys().hasOnly([
        'endpoint','expirationTime','keys','userAgent','updatedAt'
      ])
      && request.resource.data.keys().hasAll(['endpoint','keys','userAgent','updatedAt'])
      && request.resource.data.endpoint is string
      && request.resource.data.endpoint.size() <= 2000
      && request.resource.data.keys is map
      && request.resource.data.keys.keys().hasOnly(['p256dh','auth'])
      && request.resource.data.keys.keys().hasAll(['p256dh','auth'])
      && request.resource.data.keys.p256dh is string
      && request.resource.data.keys.auth is string
      && request.resource.data.userAgent is string
      && request.resource.data.userAgent.size() <= 500
      && request.resource.data.updatedAt is number;
    }

    function validCinemaReminder() {
      return request.resource.data.keys().hasOnly([
        'id','title','note','when','contentId','mediaType','kind','createdAt','sent'
      ])
      && request.resource.data.keys().hasAll([
        'id','title','note','when','contentId','mediaType','kind','createdAt','sent'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() <= 100
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 180
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 500
      && request.resource.data.when is string
      && request.resource.data.contentId is string
      && request.resource.data.contentId.matches('^[0-9]+$')
      && request.resource.data.mediaType in ['movie','tv']
      && request.resource.data.kind is string
      && request.resource.data.kind.size() <= 40
      && request.resource.data.createdAt is number
      && request.resource.data.sent is bool;
    }

    function validPreferences() {
      return request.resource.data.preferences.keys().hasOnly([
        'providerCountry','autoplayTrailers','reducedMotion'
      ])
      && request.resource.data.preferences.keys().hasAll([
        'providerCountry','autoplayTrailers','reducedMotion'
      ])
      && request.resource.data.preferences.providerCountry is string
      && request.resource.data.preferences.providerCountry.matches('^[A-Z]{2}$')
      && request.resource.data.preferences.autoplayTrailers is bool
      && request.resource.data.preferences.reducedMotion is bool;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
        'displayName','email','provider','preferences','createdAt','updatedAt'
      ])
      && (!request.resource.data.keys().hasAny(['displayName']) ||
          (request.resource.data.displayName is string &&
           request.resource.data.displayName.size() <= 100))
      && (!request.resource.data.keys().hasAny(['email']) ||
          (request.resource.data.email == null ||
           (request.resource.data.email is string &&
            request.resource.data.email.size() <= 320)))
      && (!request.resource.data.keys().hasAny(['provider']) ||
          (request.resource.data.provider is string &&
           request.resource.data.provider.size() <= 50 &&
           request.resource.data.provider in ['password', 'google.com']))
      && (!request.resource.data.keys().hasAny(['email']) ||
          request.resource.data.email == null ||
          request.resource.data.email == request.auth.token.email)
      && (!request.resource.data.keys().hasAny(['preferences']) || validPreferences())
      && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt is timestamp)
      && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId) && validProfile();
      allow delete: if isOwner(userId);

      // These index records are written only by trusted callable operations.
      // They let a member load their own private dashboard without public queries.
      match /watchRooms/{roomId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /cinemaClubs/{clubId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /achievements/{achievementId} {
        // Personal milestone records only; the app evaluates progress locally.
        // These records are not trusted as competitive proof or transferable rewards.
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && achievementId in [
            'first-favorite','favorites-5','favorites-10','favorites-25',
            'queue-first','queue-5','queue-10',
            'history-first','history-5','history-10',
            'completion-first','completion-5','whole-picture',
            'feature-focus','series-scout','library-25'
          ]
          && request.resource.data.keys().hasOnly(['id','unlockedAt','schemaVersion'])
          && request.resource.data.keys().hasAll(['id','unlockedAt','schemaVersion'])
          && request.resource.data.id == achievementId
          && request.resource.data.unlockedAt is number
          && request.resource.data.unlockedAt >= 0
          && request.resource.data.schemaVersion == 1;
        allow delete: if isOwner(userId);
      }

      match /pushSubscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPushSubscription();
        allow delete: if isOwner(userId);
      }

      match /releaseAlerts/{alertId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create, update: if false;
      }

      match /releaseStates/{stateId} {
        // Owners may inspect and erase their own release-state records when
        // deleting an account; the client cannot create or modify them.
        allow get, list: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create, update: if false;
      }


      match /cinemaReminders/{reminderId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCinemaReminder();
        allow delete: if isOwner(userId);
      }

      match /favorites/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /watchLater/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /history/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /completed/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /progress/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validProgressId(contentId) && validProgressData();
        allow delete: if isOwner(userId);
      }

      match /animePreferences/{preferenceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && preferenceId == "default" && validAnimePreferences();
        allow delete: if isOwner(userId);
      }

      match /libraryTombstones/{tombstoneId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validTombstoneData();
        allow delete: if isOwner(userId);
      }

      match /feedback/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validFeedbackData();
        allow delete: if isOwner(userId);
      }

      match /events/{eventId} {
        // Behavior events are append-only, but owners may delete their own
        // events for privacy requests and bounded-retention cleanup.
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validEventData();
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /taste/{tasteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && tasteId == "profile" && validTasteData();
        allow delete: if isOwner(userId);
      }
    }


      // Viewing profiles are private to the signed-in account. Only the
      // permanent owner profile can be bootstrapped by a client; additional
      // profiles are created later through the trusted profile API.
      function validViewingProfile(profileId) {
        return request.resource.data.keys().hasOnly([
          'id','name','avatarUrl','avatarData','avatarSource','avatarId','isKids','maturityLevel',
          'isOwner','schemaVersion','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name','avatarUrl','avatarId','isKids','maturityLevel',
          'isOwner','schemaVersion'
        ])
        && request.resource.data.id == profileId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 48
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 2048
        && (request.resource.data.avatarUrl == '' || request.resource.data.avatarUrl.matches('^https://.*'))
        && (!request.resource.data.keys().hasAny(['avatarData']) ||
          (request.resource.data.avatarData is string
            && request.resource.data.avatarData.size() <= 180000
            && (request.resource.data.avatarData == '' || request.resource.data.avatarData.matches('^data:image/webp;base64,[A-Za-z0-9+/]+={0,2}$'))))
        && (!request.resource.data.keys().hasAny(['avatarSource']) ||
          request.resource.data.avatarSource in ['google','collection','upload','default'])
        && request.resource.data.avatarId is string
        && request.resource.data.avatarId.size() <= 80
        && request.resource.data.isKids is bool
        && request.resource.data.maturityLevel in ['adult','kids']
        && request.resource.data.maturityLevel == (request.resource.data.isKids ? 'kids' : 'adult')
        && request.resource.data.isOwner == (profileId == 'owner')
        && request.resource.data.schemaVersion == 1
        && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt is timestamp)
        && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is timestamp);
      }

      function hasViewingProfile(userId, profileId) {
        return isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/profiles/$(profileId));
      }

    match /users/{userId}/profiles/{profileId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && profileId == 'owner' && validViewingProfile(profileId);
        allow update: if isOwner(userId) && profileId == 'owner'
          && resource.data.isOwner == true && validViewingProfile(profileId);
        allow delete: if isOwner(userId);

        match /migrations/{migrationId} {
          allow get, list: if hasViewingProfile(userId, profileId);
          allow create, update: if hasViewingProfile(userId, profileId)
            && migrationId == 'account-data-to-owner-profile-v1'
            && request.resource.data.keys().hasOnly([
              'migrationId','status','schemaVersion','collections','completedAt'
            ])
            && request.resource.data.migrationId == migrationId
            && request.resource.data.status in ['started','complete']
            && request.resource.data.schemaVersion == 1
            && request.resource.data.collections is map
            && request.resource.data.collections.keys().hasOnly([
              'favorites','watchLater','history','completed','progress',
              'libraryTombstones','feedback','events','taste','animePreferences','achievements'
            ]);
          allow delete: if hasViewingProfile(userId, profileId);
        }

        // The profile counter is server-managed. Owners may read/delete it during
        // account deletion, but cannot create or alter it from a client.
        match /profileManagement/{documentId} {
          allow get, list, delete: if isOwner(userId) && profileId == 'owner';
          allow create, update: if false;
        }

        match /{profileCollection}/{documentId} {
          allow read: if hasViewingProfile(userId, profileId)
            && profileCollection in [
              'favorites','watchLater','history','completed','progress',
              'libraryTombstones','feedback','events','taste','animePreferences','achievements'
            ];
          allow create, update: if hasViewingProfile(userId, profileId)
            && (
              (profileCollection in ['favorites','watchLater','history','completed']
                && validContentId(documentId) && validLibraryData())
              || (profileCollection == 'progress'
                && validProgressId(documentId) && validProgressData())
              || (profileCollection == 'libraryTombstones'
                && validTombstoneData())
              || (profileCollection == 'feedback'
                && validFeedbackData())
              || (profileCollection == 'events'
                && validEventData())
              || (profileCollection == 'taste'
                && documentId == 'profile' && validTasteData())
              || (profileCollection == 'animePreferences'
                && documentId == 'default' && validAnimePreferences())
              || (profileCollection == 'achievements'
                && documentId in [
                  'first-favorite','favorites-5','favorites-10','favorites-25',
                  'queue-first','queue-5','queue-10',
                  'history-first','history-5','history-10',
                  'completion-first','completion-5','whole-picture',
                  'feature-focus','series-scout','library-25'
                ]
                && request.resource.data.keys().hasOnly(['id','unlockedAt','schemaVersion'])
                && request.resource.data.id == documentId
                && request.resource.data.unlockedAt is number
                && request.resource.data.unlockedAt >= 0
                && request.resource.data.schemaVersion == 1)
            );
          allow delete: if hasViewingProfile(userId, profileId)
            && profileCollection in [
              'favorites','watchLater','history','completed','progress',
              'libraryTombstones','feedback','events','taste','animePreferences','achievements'
            ];
        }
      }

    // Public editorial content is written only by trusted ingestion/editor tooling.
    function verifiedMember() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isModerator() {
      return signedIn() && request.auth.token.moderator == true;
    }

    function validPublicName(name) {
      return name is string && name.size() >= 1 && name.size() <= 80
        && ((request.auth.token.name is string && name == request.auth.token.name)
          || (!(request.auth.token.name is string) && name == 'Vivid member'));
    }

    function validCommunityPost() {
      return request.resource.data.keys().hasOnly([
        'authorId','authorName','body','topic','spoiler','status','createdAt','updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'authorId','authorName','body','topic','spoiler','status','createdAt','updatedAt'
      ])
      && request.resource.data.authorId == request.auth.uid
      && validPublicName(request.resource.data.authorName)
      && request.resource.data.body is string
      && request.resource.data.body.size() >= 3
      && request.resource.data.body.size() <= 1600
      && request.resource.data.topic in [
        'general','ghana','nollywood','african-cinema','film','television','streaming','celebrity','theory'
      ]
      && request.resource.data.spoiler is bool
      && request.resource.data.status == 'published'
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
    }

    function validCommunityComment() {
      return request.resource.data.keys().hasOnly([
        'authorId','authorName','body','createdAt','updatedAt','status'
      ])
      && request.resource.data.keys().hasAll([
        'authorId','authorName','body','createdAt','updatedAt','status'
      ])
      && request.resource.data.authorId == request.auth.uid
      && validPublicName(request.resource.data.authorName)
      && request.resource.data.body is string
      && request.resource.data.body.size() >= 2
      && request.resource.data.body.size() <= 1800
      && request.resource.data.status == 'published'
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
    }

    match /newsQueue/{queueId} {
      // Only trusted moderators can inspect discovered feed candidates.
      // Admin SDK ingestion is server-side and bypasses client rules.
      allow get, list: if isModerator();
      allow create, delete: if false;
      allow update: if isModerator()
        && resource.data.status == 'pending_review'
        && request.resource.data.status in ['published','dismissed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy','reviewNotes','articleId'])
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewNotes is string
        && request.resource.data.reviewNotes.size() >= 10
        && request.resource.data.reviewNotes.size() <= 500
        && (
          (request.resource.data.status == 'dismissed' && !request.resource.data.keys().hasAny(['articleId']))
          ||
          (request.resource.data.status == 'published'
            && request.resource.data.articleId is string
            && request.resource.data.articleId.size() > 0
            && existsAfter(/databases/$(database)/documents/articles/$(request.resource.data.articleId))
            && getAfter(/databases/$(database)/documents/articles/$(request.resource.data.articleId)).data.status == 'published'
            && getAfter(/databases/$(database)/documents/articles/$(request.resource.data.articleId)).data.canonicalUrl == resource.data.canonicalUrl
            && getAfter(/databases/$(database)/documents/articles/$(request.resource.data.articleId)).data.sourceId == resource.data.sourceId)
        );
    }

    match /articles/{articleId} {
      allow get, list: if resource.data.status == 'published';
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow get, list: if resource.data.status == 'published'
          && get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published';
        allow create: if verifiedMember()
          && get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published'
          && validCommunityComment();
        allow update: if isModerator() || (verifiedMember()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 2
          && request.resource.data.body.size() <= 1800
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','updatedAt']));
        allow delete: if isModerator() || (verifiedMember() && resource.data.authorId == request.auth.uid);
      }

      match /reactions/{userId} {
        allow read: if get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published';
        allow create: if verifiedMember() && request.auth.uid == userId
          && get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published'
          && request.resource.data.keys().hasOnly(['userId','createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if verifiedMember() && request.auth.uid == userId;
      }
    }

    match /communityPosts/{postId} {
      allow get, list: if resource.data.status == 'published';
      allow create: if verifiedMember() && validCommunityPost();
      allow update: if isModerator()
        || (verifiedMember() && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','topic','spoiler','updatedAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 3
          && request.resource.data.body.size() <= 1600
          && request.resource.data.updatedAt == request.time);
      allow delete: if isModerator() || (verifiedMember() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow get, list: if resource.data.status == 'published'
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published';
        allow create: if verifiedMember()
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published'
          && validCommunityComment();
        allow update: if isModerator()
          || (verifiedMember() && resource.data.authorId == request.auth.uid
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.authorName == resource.data.authorName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == resource.data.status
            && request.resource.data.updatedAt == request.time
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 2
            && request.resource.data.body.size() <= 700
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','updatedAt']));
        allow delete: if isModerator() || (verifiedMember() && resource.data.authorId == request.auth.uid);
      }

      match /reactions/{userId} {
        allow read: if get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published';
        allow create: if verifiedMember() && request.auth.uid == userId
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published'
          && request.resource.data.keys().hasOnly(['userId','createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if verifiedMember() && request.auth.uid == userId;
      }
    }

    // Public profiles are intentionally separated from private account documents.
    match /publicProfiles/{userId} {
      allow get, list: if true;
      allow create: if verifiedMember() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','bio','avatarUrl','createdAt','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 240
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if verifiedMember() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','bio','avatarUrl','createdAt','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 240
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 1000
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if verifiedMember() && request.auth.uid == userId;
    }

    match /communityPolls/{pollId} {
      allow get, list: if resource.data.status == 'published';
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(['authorId','authorName','question','options','topic','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['authorId','authorName','question','options','topic','status','createdAt','updatedAt'])
        && request.resource.data.authorId == request.auth.uid
        && validPublicName(request.resource.data.authorName)
        && request.resource.data.question is string
        && request.resource.data.question.size() >= 3
        && request.resource.data.question.size() <= 1600
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2
        && request.resource.data.options.size() <= 4
        && request.resource.data.options[0] is string
        && request.resource.data.options[0].size() >= 1
        && request.resource.data.options[0].size() <= 90
        && request.resource.data.options[1] is string
        && request.resource.data.options[1].size() >= 1
        && request.resource.data.options[1].size() <= 90
        && (request.resource.data.options.size() < 3 || (request.resource.data.options[2] is string && request.resource.data.options[2].size() >= 1 && request.resource.data.options[2].size() <= 90))
        && (request.resource.data.options.size() < 4 || (request.resource.data.options[3] is string && request.resource.data.options[3].size() >= 1 && request.resource.data.options[3].size() <= 90))
        && request.resource.data.topic in ['general','ghana','nollywood','african-cinema','film','television','streaming','celebrity','theory']
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isModerator();
      allow delete: if isModerator() || (verifiedMember() && resource.data.authorId == request.auth.uid);

      match /votes/{userId} {
        allow get: if signedIn() && request.auth.uid == userId
          && get(/databases/$(database)/documents/communityPolls/$(pollId)).data.status == 'published';
        allow list: if false;
        allow create: if verifiedMember() && request.auth.uid == userId
          && get(/databases/$(database)/documents/communityPolls/$(pollId)).data.status == 'published'
          && request.resource.data.keys().hasOnly(['userId','optionIndex','createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.optionIndex is int
          && request.resource.data.optionIndex >= 0
          && request.resource.data.optionIndex < get(/databases/$(database)/documents/communityPolls/$(pollId)).data.options.size()
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /communityReports/{reportId} {
      allow create: if verifiedMember()
        && request.resource.data.keys().hasOnly(['reporterId','targetType','targetId','postId','articleId','reason','status','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['communityPost','communityComment','communityPoll','articleComment','article','user']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 180
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 240
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow get, list, update, delete: if isModerator();
    }

    match /users/{userId}/blockedUsers/{blockedUid} {
      allow get, list: if isOwner(userId);
      allow create: if verifiedMember() && isOwner(userId) && blockedUid != userId
        && request.resource.data.keys().hasOnly(['blockedUid','createdAt'])
        && request.resource.data.blockedUid == blockedUid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/following/{targetUid} {
      allow get, list: if isOwner(userId);
      allow create: if verifiedMember() && isOwner(userId) && targetUid != userId
        && request.resource.data.keys().hasOnly(['targetUid','createdAt'])
        && request.resource.data.targetUid == targetUid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/followedTopics/{topicId} {
      allow get, list: if isOwner(userId);
      allow create: if verifiedMember() && isOwner(userId)
        && topicId in ['general','ghana','nollywood','african-cinema','film','television','streaming','celebrity','theory']
        && request.resource.data.keys().hasOnly(['topicId','createdAt'])
        && request.resource.data.topicId == topicId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(userId);
    }


    function validNewsSource(sourceId) {
      return request.resource.data.keys().hasOnly(['publisher','domain','status','defaultRegion','defaultCategory','feedUrl','feedApproved','ingestionEnabled','imageUsageApproved','reviewNotes','verifiedBy','verifiedAt','createdAt','updatedAt'])
        && request.resource.data.domain == sourceId
        && request.resource.data.publisher is string
        && request.resource.data.publisher.size() >= 2
        && request.resource.data.publisher.size() <= 120
        && request.resource.data.status == 'approved'
        && request.resource.data.defaultRegion in ['global','hollywood','india','africa','asia','europe','latin-america','middle-east','ghana','nigeria']
        && request.resource.data.defaultCategory in ['film','television','streaming','music','gaming','anime','animation','box-office','celebrity','trailers','awards','festivals','production','business','legal','industry','comics','theatre','podcasts','creators','ghana','nollywood','africa','india','asia','hollywood','europe','latin-america','middle-east']
        && request.resource.data.feedUrl is string
        && request.resource.data.feedApproved is bool
        && request.resource.data.imageUsageApproved is bool
        && request.resource.data.ingestionEnabled is bool
        && ((request.resource.data.feedUrl == '' && !request.resource.data.feedApproved && !request.resource.data.ingestionEnabled) || (request.resource.data.feedUrl.matches('^https://.*') && request.resource.data.feedApproved))
        && (!request.resource.data.ingestionEnabled || (request.resource.data.feedApproved && request.resource.data.feedUrl.matches('^https://.*')))
        && request.resource.data.reviewNotes is string
        && request.resource.data.reviewNotes.size() >= 10
        && request.resource.data.reviewNotes.size() <= 1000
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt is timestamp;
    }

    function validEditorialArticle() {
      let sourcePath = /databases/$(database)/documents/newsSources/$(request.resource.data.sourceId);
      return request.resource.data.keys().hasOnly(['headline','publisher','author','sourceUrl','canonicalUrl','sourceId','category','region','summary','body','imageUrl','imageAlt','publishedAt','updatedAt','ingestedAt','status','origin','featured','editorialReviewed','correction','topics'])
        && request.resource.data.keys().hasAll(['headline','publisher','author','sourceUrl','canonicalUrl','sourceId','category','region','summary','body','imageUrl','imageAlt','publishedAt','updatedAt','ingestedAt','status','origin','featured','editorialReviewed','correction','topics'])
        && request.resource.data.sourceId is string
        && request.resource.data.sourceId.matches('^[a-z0-9.-]+$')
        && exists(sourcePath)
        && get(sourcePath).data.status == 'approved'
        && get(sourcePath).data.domain == request.resource.data.sourceId
        && get(sourcePath).data.publisher == request.resource.data.publisher
        && request.resource.data.headline is string
        && request.resource.data.headline.size() >= 8
        && request.resource.data.headline.size() <= 240
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.matches('^https://.*')
        && request.resource.data.sourceUrl.size() <= 2000
        && request.resource.data.sourceUrl.split('/').size() >= 4
        && request.resource.data.sourceUrl.split('/')[2] in [request.resource.data.sourceId, 'www.' + request.resource.data.sourceId]
        && request.resource.data.canonicalUrl is string
        && request.resource.data.canonicalUrl.matches('^https://.*')
        && request.resource.data.canonicalUrl.size() <= 2000
        && request.resource.data.canonicalUrl.split('/').size() >= 4
        && request.resource.data.canonicalUrl.split('/')[2] in [request.resource.data.sourceId, 'www.' + request.resource.data.sourceId]
        && request.resource.data.category in ['film','television','streaming','music','gaming','anime','animation','box-office','celebrity','trailers','awards','festivals','production','business','legal','industry','comics','theatre','podcasts','creators','ghana','nollywood','africa','india','asia','hollywood','europe','latin-america','middle-east']
        && request.resource.data.region in ['global','hollywood','india','africa','asia','europe','latin-america','middle-east','ghana','nigeria']
        && request.resource.data.summary is string
        && request.resource.data.summary.size() >= 1
        && request.resource.data.summary.size() <= 700
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2000
        && (request.resource.data.imageUrl == '' || (
          get(sourcePath).data.imageUsageApproved == true
          && request.resource.data.imageUrl.matches('^https://.*')
          && request.resource.data.imageUrl.split('/').size() >= 4
          && request.resource.data.imageUrl.split('/')[2] in [request.resource.data.sourceId, 'www.' + request.resource.data.sourceId]
        ))
        && request.resource.data.imageAlt is string
        && request.resource.data.imageAlt.size() <= 240
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 120
        && request.resource.data.publisher is string
        && request.resource.data.publisher.size() >= 2
        && request.resource.data.publisher.size() <= 120
        && request.resource.data.correction is string
        && request.resource.data.correction.size() <= 500
        && request.resource.data.publishedAt is timestamp
        && request.resource.data.publishedAt <= request.time
        && request.resource.data.updatedAt == request.resource.data.publishedAt
        && request.resource.data.ingestedAt == request.time
        && request.resource.data.status == 'published'
        && request.resource.data.origin == 'editorial'
        && request.resource.data.featured is bool
        && request.resource.data.editorialReviewed == true
        && request.resource.data.topics is list
        && request.resource.data.topics.size() == 2;
    }

    match /newsSources/{sourceId} {
      allow get, list: if isModerator();
      allow create: if isModerator() && validNewsSource(sourceId) && request.resource.data.createdAt == request.time;
      allow update: if isModerator() && validNewsSource(sourceId) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isModerator();
    }

    match /articles/{articleId} {
      allow create: if isModerator() && validEditorialArticle();
      allow update: if isModerator() && ((validEditorialArticle() && request.resource.data.sourceId == resource.data.sourceId) || (resource.data.status == 'published' && request.resource.data.status == 'hidden' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','moderatedAt','moderatedBy']) && request.resource.data.moderatedAt == request.time && request.resource.data.moderatedBy == request.auth.uid));
      allow delete: if isModerator();
    }

    // Watch Rooms and Cinema Clubs are created and mutated only by trusted
    // callable functions. Members can read only spaces they have joined.
    match /rooms/{roomId} {
      allow get: if isRoomMember(roomId);
      allow list: if false;
      allow create, update, delete: if false;

      match /members/{memberUid} {
        allow get, list: if isRoomMember(roomId);
        allow create, update, delete: if false;
      }

      // Lobby data is readable only by current room members. All mutations
      // pass through trusted callable functions so clients cannot forge roles,
      // votes, presence leases or chat metadata.
      match /presence/{memberUid} {
        allow get, list: if isRoomMember(roomId);
        allow create, update, delete: if false;
      }
      match /queue/{itemId} {
        allow get, list: if isRoomMember(roomId);
        allow create, update, delete: if false;
      }
      match /chat/{messageId} {
        allow get, list: if isRoomMember(roomId);
        allow create, update, delete: if false;
      }

      // Authoritative playback snapshots are callable-written; members can subscribe, clients cannot write.
      match /playback/{stateId} {
        allow get, list: if isRoomMember(roomId);
        allow create, update, delete: if false;
      }
    }

    match /cinemaClubs/{clubId} {
      allow get: if isClubMember(clubId);
      allow list: if false;
      allow create, update, delete: if false;

      match /members/{memberUid} {
        allow get, list: if isClubMember(clubId);
        allow create, update, delete: if false;
      }
    }

    // Cinema Club durable experience: members can read shared watchlists,
    // screening history, member ratings and discussion; trusted Vercel API operations own writes.
    match /cinemaClubs/{clubId}/watchlist/{itemId} {
      allow get, list: if isClubMember(clubId);
      allow create, update, delete: if false;
    }
    match /cinemaClubs/{clubId}/screenings/{screeningId} {
      allow get, list: if isClubMember(clubId);
      allow create, update, delete: if false;

      match /afterCredits/{userId} {
        allow get, list: if isClubMember(clubId);
        allow create, update, delete: if false;
      }
      match /discussion/{messageId} {
        allow get, list: if isClubMember(clubId);
        allow create, update, delete: if false;
      }
    }

    // Invitation codes are stored as SHA-256 hashes and never exposed to clients.
    match /watchInvitations/{tokenHash} {
      allow read, write: if false;
    }

    // Product analytics: users may create only their own bounded event records.
    // Only the dashboard administrator can read the collection; events are immutable.
    match /analyticsEvents/{eventId} {
      allow read: if signedIn() && request.auth.uid == 'awiBvDUVZvdyKnvOpGtD0rh2nZf1';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['event','platform','userId','sessionId','timestamp','appVersion','details'])
        && request.resource.data.keys().hasAll(['event','platform','userId','sessionId','timestamp','appVersion','details'])
        && request.resource.data.event is string
        && request.resource.data.event.matches('^[a-z][a-z0-9_]{0,59}$')
        && request.resource.data.platform in ['windows','android','web','pwa']
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() >= 1
        && request.resource.data.sessionId.size() <= 128
        && request.resource.data.timestamp == request.time
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() >= 1
        && request.resource.data.appVersion.size() <= 40
        && request.resource.data.details is map
        && request.resource.data.details.keys().size() <= 20;
      allow update, delete: if false;
    }

    // African Stories public catalogue projections are read-only to clients.
    // Privileged publication and every private workflow use Cloud Functions/Admin SDK.
    match /africanWorksPublic/{workId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    match /africanPeoplePublic/{personId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    match /africanInstitutionsPublic/{institutionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    match /africanCollectionsPublic/{collectionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    match /africanTimelinesPublic/{entryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // Drafts, rights grants, provider configuration, review queues, sessions
    // and audit events contain private or security-sensitive data. No browser
    // client, including a custom-claim holder, may access these documents.
    match /africanWorkDrafts/{document=**} {
      allow read, write: if false;
    }
    match /africanRightsGrants/{document=**} {
      allow read, write: if false;
    }
    match /africanProviderRegistryPrivate/{document=**} {
      allow read, write: if false;
    }
    match /africanEditorialQueue/{document=**} {
      allow read, write: if false;
    }
    match /africanPlaybackSessions/{document=**} {
      allow read, write: if false;
    }
    match /africanAuditEvents/{document=**} {
      allow read, write: if false;
    }


    // Anime Premium billing, entitlements, authorised sources and audit trails
    // are server-owned. Even signed-in users and custom-claim admins must use
    // the authenticated Cloudflare API; browser clients cannot read or mutate them.
    match /animePremiumMemberships/{uid} {
      allow read, write: if false;
    }
    match /animePremiumCheckouts/{reference} {
      allow read, write: if false;
    }
    match /animePremiumPendingSubscriptions/{subscriptionCode} {
      allow read, write: if false;
    }
    match /animePremiumWebhookEvents/{eventId} {
      allow read, write: if false;
    }
    match /animePremiumSources/{sourceId} {
      allow read, write: if false;
    }
    match /animePremiumProfiles/{uid} {
      allow read, write: if false;
    }
    match /animePremiumPlaybackSessions/{sessionId} {
      allow read, write: if false;
    }
    match /animePremiumRateLimits/{rateLimitId} {
      allow read, write: if false;
    }
    match /animePremiumAdminAudit/{auditId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
