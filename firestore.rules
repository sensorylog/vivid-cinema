rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validContentId(contentId) {
      return contentId.matches('^(movie|tv):[0-9]+$');
    }

    function validLibraryData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','title','year','poster_path','backdrop_path','updatedAt',
        'startedAt','lastWatchedAt','watchedSeconds','completion','completedAt'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.matches('^[0-9]+$')
      && request.resource.data.media_type in ['movie', 'tv']
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 300
      && request.resource.data.year is string
      && request.resource.data.year.size() <= 10
      && request.resource.data.poster_path is string
      && request.resource.data.poster_path.size() <= 500
      && request.resource.data.backdrop_path is string
      && request.resource.data.backdrop_path.size() <= 500
      && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is number)
      && (!request.resource.data.keys().hasAny(['startedAt']) || request.resource.data.startedAt is number)
      && (!request.resource.data.keys().hasAny(['lastWatchedAt']) || request.resource.data.lastWatchedAt is number)
      && (!request.resource.data.keys().hasAny(['watchedSeconds']) || request.resource.data.watchedSeconds is number)
      && (!request.resource.data.keys().hasAny(['completion']) || (
        request.resource.data.completion is number &&
        request.resource.data.completion >= 0 &&
        request.resource.data.completion <= 100
      ))
      && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is number);
    }

    function validProgressData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','progress','duration','percentage','completed','completedAt',
        'season','episode','title','updatedAt'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.matches('^[0-9]+$')
      && request.resource.data.media_type in ['movie','tv']
      && request.resource.data.progress is number
      && request.resource.data.progress >= 0
      && request.resource.data.duration is number
      && request.resource.data.duration >= 0
      && request.resource.data.percentage is number
      && request.resource.data.percentage >= 0
      && request.resource.data.percentage <= 100
      && request.resource.data.completed is bool
      && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is number)
      && (!request.resource.data.keys().hasAny(['season']) || request.resource.data.season == null || request.resource.data.season is number)
      && (!request.resource.data.keys().hasAny(['episode']) || request.resource.data.episode == null || request.resource.data.episode is number)
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 300
      && request.resource.data.updatedAt is number;
    }

    function validTombstoneData() {
      return request.resource.data.keys().hasOnly(['collection','contentId','deletedAt'])
      && request.resource.data.collection in ['favorites','watchLater','history']
      && request.resource.data.contentId is string
      && request.resource.data.contentId.matches('^(movie|tv):[0-9]+$')
      && request.resource.data.deletedAt is number;
    }

    function validFeedbackData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','title','year','poster_path','backdrop_path','kind','updatedAt'
      ])
      && request.resource.data.kind in ['like','not_for_me','cleared']
      && request.resource.data.updatedAt is number
      && (!request.resource.data.keys().hasAny(['id']) || request.resource.data.id.matches('^[0-9]+$'))
      && (!request.resource.data.keys().hasAny(['media_type']) || request.resource.data.media_type in ['movie','tv'])
      && (!request.resource.data.keys().hasAny(['title']) || (request.resource.data.title is string && request.resource.data.title.size() <= 300))
      && (!request.resource.data.keys().hasAny(['year']) || request.resource.data.year is string)
      && (!request.resource.data.keys().hasAny(['poster_path']) || request.resource.data.poster_path is string)
      && (!request.resource.data.keys().hasAny(['backdrop_path']) || request.resource.data.backdrop_path is string);
    }

    function validEventData() {
      return request.resource.data.keys().hasOnly([
        'id','type','contentId','mediaType','occurredAt','sessionId','metadata'
      ])
      && request.resource.data.id is string
      && request.resource.data.type is string
      && request.resource.data.type.size() <= 60
      && request.resource.data.occurredAt is number
      && request.resource.data.sessionId is string
      && request.resource.data.sessionId.size() <= 100
      && (!request.resource.data.keys().hasAny(['contentId']) || request.resource.data.contentId == null || request.resource.data.contentId.matches('^(movie|tv):[0-9]+$'))
      && (!request.resource.data.keys().hasAny(['mediaType']) || request.resource.data.mediaType == null || request.resource.data.mediaType in ['movie','tv'])
      && (!request.resource.data.keys().hasAny(['metadata']) || request.resource.data.metadata is map);
    }

    function validTasteData() {
      return request.resource.data.keys().hasOnly([
        'version','genres','languages','countries','actors','directors','media','decades','updatedAt'
      ])
      && request.resource.data.version is number
      && request.resource.data.genres is map
      && request.resource.data.languages is map
      && request.resource.data.countries is map
      && request.resource.data.actors is map
      && request.resource.data.directors is map
      && request.resource.data.media is map
      && request.resource.data.decades is map
      && request.resource.data.updatedAt is number;
    }

    function validPushSubscription() {
      return request.resource.data.keys().hasOnly([
        'endpoint','expirationTime','keys','userAgent','updatedAt'
      ])
      && request.resource.data.keys().hasAll(['endpoint','keys','userAgent','updatedAt'])
      && request.resource.data.endpoint is string
      && request.resource.data.endpoint.size() <= 2000
      && request.resource.data.keys is map
      && request.resource.data.keys.keys().hasOnly(['p256dh','auth'])
      && request.resource.data.keys.keys().hasAll(['p256dh','auth'])
      && request.resource.data.keys.p256dh is string
      && request.resource.data.keys.auth is string
      && request.resource.data.userAgent is string
      && request.resource.data.userAgent.size() <= 500
      && request.resource.data.updatedAt is number;
    }

    function validCinemaReminder() {
      return request.resource.data.keys().hasOnly([
        'id','title','note','when','contentId','mediaType','kind','createdAt','sent'
      ])
      && request.resource.data.keys().hasAll([
        'id','title','note','when','contentId','mediaType','kind','createdAt','sent'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() <= 100
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 180
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 500
      && request.resource.data.when is string
      && request.resource.data.contentId is string
      && request.resource.data.contentId.matches('^[0-9]+$')
      && request.resource.data.mediaType in ['movie','tv']
      && request.resource.data.kind is string
      && request.resource.data.kind.size() <= 40
      && request.resource.data.createdAt is number
      && request.resource.data.sent is bool;
    }

    function validPreferences() {
      return request.resource.data.preferences.keys().hasOnly([
        'providerCountry','autoplayTrailers','reducedMotion'
      ])
      && request.resource.data.preferences.keys().hasAll([
        'providerCountry','autoplayTrailers','reducedMotion'
      ])
      && request.resource.data.preferences.providerCountry is string
      && request.resource.data.preferences.providerCountry.matches('^[A-Z]{2}$')
      && request.resource.data.preferences.autoplayTrailers is bool
      && request.resource.data.preferences.reducedMotion is bool;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
        'displayName','email','provider','preferences','createdAt','updatedAt'
      ])
      && (!request.resource.data.keys().hasAny(['displayName']) ||
          (request.resource.data.displayName is string &&
           request.resource.data.displayName.size() <= 100))
      && (!request.resource.data.keys().hasAny(['email']) ||
          (request.resource.data.email == null ||
           (request.resource.data.email is string &&
            request.resource.data.email.size() <= 320)))
      && (!request.resource.data.keys().hasAny(['provider']) ||
          (request.resource.data.provider is string &&
           request.resource.data.provider.size() <= 50))
      && (!request.resource.data.keys().hasAny(['preferences']) || validPreferences())
      && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt is timestamp)
      && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId) && validProfile();
      allow delete: if isOwner(userId);

      match /pushSubscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPushSubscription();
        allow delete: if isOwner(userId);
      }

      match /cinemaReminders/{reminderId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCinemaReminder();
        allow delete: if isOwner(userId);
      }

      match /favorites/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /watchLater/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /history/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /progress/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validProgressData();
        allow delete: if isOwner(userId);
      }

      match /libraryTombstones/{tombstoneId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validTombstoneData();
        allow delete: if isOwner(userId);
      }

      match /feedback/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validFeedbackData();
        allow delete: if isOwner(userId);
      }

      match /events/{eventId} {
        allow create: if isOwner(userId) && validEventData();
        allow read, update, delete: if false;
      }

      match /taste/{tasteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && tasteId == "profile" && validTasteData();
        allow delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
