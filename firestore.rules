rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validContentId() {
      return contentId.matches('^(movie|tv):[0-9]+$');
    }

    function validLibraryData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','title','year','poster_path','backdrop_path','updatedAt',
        'startedAt','lastWatchedAt','watchedSeconds','completion','completedAt'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.matches('^[0-9]+$')
      && request.resource.data.media_type in ['movie', 'tv']
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 300
      && request.resource.data.year is string
      && request.resource.data.year.size() <= 10
      && request.resource.data.poster_path is string
      && request.resource.data.poster_path.size() <= 500
      && request.resource.data.backdrop_path is string
      && request.resource.data.backdrop_path.size() <= 500
      && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is number)
      && (!request.resource.data.keys().hasAny(['startedAt']) || request.resource.data.startedAt is number)
      && (!request.resource.data.keys().hasAny(['lastWatchedAt']) || request.resource.data.lastWatchedAt is number)
      && (!request.resource.data.keys().hasAny(['watchedSeconds']) || request.resource.data.watchedSeconds is number)
      && (!request.resource.data.keys().hasAny(['completion']) || (
        request.resource.data.completion is number &&
        request.resource.data.completion >= 0 &&
        request.resource.data.completion <= 100
      ))
      && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is number);
    }

    function validProgressData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','progress','duration','percentage','completed','completedAt','season','episode','title','updatedAt'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.matches('^[0-9]+$')
      && request.resource.data.media_type in ['movie','tv']
      && request.resource.data.progress is number
      && request.resource.data.progress >= 0
      && request.resource.data.duration is number
      && request.resource.data.duration >= 0
      && request.resource.data.percentage is number
      && request.resource.data.percentage >= 0
      && request.resource.data.percentage <= 100
      && request.resource.data.completed is bool
      && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is number)
      && (!request.resource.data.keys().hasAny(['season']) || request.resource.data.season == null || request.resource.data.season is number)
      && (!request.resource.data.keys().hasAny(['episode']) || request.resource.data.episode == null || request.resource.data.episode is number)
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 300
      && request.resource.data.updatedAt is number;
    }

    function validTombstoneData() {
      return request.resource.data.keys().hasOnly(['collection','contentId','deletedAt'])
      && request.resource.data.collection in ['favorites','watchLater','history']
      && request.resource.data.contentId.matches('^(movie|tv):[0-9]+$')
      && request.resource.data.deletedAt is number;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
        'displayName','email','provider','preferences','createdAt','updatedAt'
      ])
      && (!request.resource.data.keys().hasAny(['displayName']) ||
          (request.resource.data.displayName is string &&
           request.resource.data.displayName.size() <= 100))
      && (!request.resource.data.keys().hasAny(['email']) ||
          (request.resource.data.email == null ||
           (request.resource.data.email is string &&
            request.resource.data.email.size() <= 320)))
      && (!request.resource.data.keys().hasAny(['provider']) ||
          (request.resource.data.provider is string &&
           request.resource.data.provider.size() <= 50))
      && (!request.resource.data.keys().hasAny(['preferences']) || validPreferences())
      && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt is timestamp)
      && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is timestamp);
    }

    function validPreferences() {
      return request.resource.data.preferences.keys().hasOnly([
        'providerCountry','autoplayTrailers','reducedMotion'
      ])
      && request.resource.data.preferences.providerCountry is string
      && request.resource.data.preferences.providerCountry.matches('^[A-Z]{2}$')
      && request.resource.data.preferences.autoplayTrailers is bool
      && request.resource.data.preferences.reducedMotion is bool;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId) && validProfile();
      allow delete: if isOwner(userId);

      match /favorites/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId() && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /watchLater/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId() && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /history/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId() && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /progress/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId() && validProgressData();
        allow delete: if isOwner(userId);
      }

      match /libraryTombstones/{tombstoneId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validTombstoneData();
        allow delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
