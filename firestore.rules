rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validContentId(contentId) {
      return contentId.matches('^(movie|tv):[0-9]+$');
    }

    function validLibraryData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','title','year','poster_path','backdrop_path','updatedAt',
        'startedAt','lastWatchedAt','watchedSeconds','completion','completedAt'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.matches('^[0-9]+$')
      && request.resource.data.media_type in ['movie', 'tv']
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 300
      && request.resource.data.year is string
      && request.resource.data.year.size() <= 10
      && request.resource.data.poster_path is string
      && request.resource.data.poster_path.size() <= 500
      && request.resource.data.backdrop_path is string
      && request.resource.data.backdrop_path.size() <= 500
      && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is number)
      && (!request.resource.data.keys().hasAny(['startedAt']) || request.resource.data.startedAt is number)
      && (!request.resource.data.keys().hasAny(['lastWatchedAt']) || request.resource.data.lastWatchedAt is number)
      && (!request.resource.data.keys().hasAny(['watchedSeconds']) || request.resource.data.watchedSeconds is number)
      && (!request.resource.data.keys().hasAny(['completion']) || (
        request.resource.data.completion is number &&
        request.resource.data.completion >= 0 &&
        request.resource.data.completion <= 100
      ))
      && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is number);
    }

    function validProgressData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','progress','duration','percentage','completed','completedAt',
        'season','episode','title','updatedAt'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.matches('^[0-9]+$')
      && request.resource.data.media_type in ['movie','tv']
      && request.resource.data.progress is number
      && request.resource.data.progress >= 0
      && request.resource.data.duration is number
      && request.resource.data.duration >= 0
      && request.resource.data.percentage is number
      && request.resource.data.percentage >= 0
      && request.resource.data.percentage <= 100
      && request.resource.data.completed is bool
      && (!request.resource.data.keys().hasAny(['completedAt']) || request.resource.data.completedAt is number)
      && (!request.resource.data.keys().hasAny(['season']) || request.resource.data.season == null || request.resource.data.season is number)
      && (!request.resource.data.keys().hasAny(['episode']) || request.resource.data.episode == null || request.resource.data.episode is number)
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 300
      && request.resource.data.updatedAt is number;
    }

    function validTombstoneData() {
      return request.resource.data.keys().hasOnly(['collection','contentId','deletedAt'])
      && request.resource.data.collection in ['favorites','watchLater','history']
      && request.resource.data.contentId is string
      && request.resource.data.contentId.matches('^(movie|tv):[0-9]+$')
      && request.resource.data.deletedAt is number;
    }

    function validFeedbackData() {
      return request.resource.data.keys().hasOnly([
        'id','media_type','title','year','poster_path','backdrop_path','kind','updatedAt'
      ])
      && request.resource.data.kind in ['like','not_for_me','cleared']
      && request.resource.data.updatedAt is number
      && (!request.resource.data.keys().hasAny(['id']) || request.resource.data.id.matches('^[0-9]+$'))
      && (!request.resource.data.keys().hasAny(['media_type']) || request.resource.data.media_type in ['movie','tv'])
      && (!request.resource.data.keys().hasAny(['title']) || (request.resource.data.title is string && request.resource.data.title.size() <= 300))
      && (!request.resource.data.keys().hasAny(['year']) || request.resource.data.year is string)
      && (!request.resource.data.keys().hasAny(['poster_path']) || request.resource.data.poster_path is string)
      && (!request.resource.data.keys().hasAny(['backdrop_path']) || request.resource.data.backdrop_path is string);
    }

    function validEventData() {
      return request.resource.data.keys().hasOnly([
        'id','type','contentId','mediaType','occurredAt','sessionId','metadata'
      ])
      && request.resource.data.id is string
      && request.resource.data.type is string
      && request.resource.data.type.size() <= 60
      && request.resource.data.occurredAt is number
      && request.resource.data.sessionId is string
      && request.resource.data.sessionId.size() <= 100
      && (!request.resource.data.keys().hasAny(['contentId']) || request.resource.data.contentId == null || request.resource.data.contentId.matches('^(movie|tv):[0-9]+$'))
      && (!request.resource.data.keys().hasAny(['mediaType']) || request.resource.data.mediaType == null || request.resource.data.mediaType in ['movie','tv'])
      && (!request.resource.data.keys().hasAny(['metadata']) || request.resource.data.metadata is map);
    }

    function validTasteData() {
      return request.resource.data.keys().hasOnly([
        'version','genres','languages','countries','actors','directors','media','decades','updatedAt'
      ])
      && request.resource.data.version is number
      && request.resource.data.genres is map
      && request.resource.data.languages is map
      && request.resource.data.countries is map
      && request.resource.data.actors is map
      && request.resource.data.directors is map
      && request.resource.data.media is map
      && request.resource.data.decades is map
      && request.resource.data.updatedAt is number;
    }

    function validPushSubscription() {
      return request.resource.data.keys().hasOnly([
        'endpoint','expirationTime','keys','userAgent','updatedAt'
      ])
      && request.resource.data.keys().hasAll(['endpoint','keys','userAgent','updatedAt'])
      && request.resource.data.endpoint is string
      && request.resource.data.endpoint.size() <= 2000
      && request.resource.data.keys is map
      && request.resource.data.keys.keys().hasOnly(['p256dh','auth'])
      && request.resource.data.keys.keys().hasAll(['p256dh','auth'])
      && request.resource.data.keys.p256dh is string
      && request.resource.data.keys.auth is string
      && request.resource.data.userAgent is string
      && request.resource.data.userAgent.size() <= 500
      && request.resource.data.updatedAt is number;
    }

    function validCinemaReminder() {
      return request.resource.data.keys().hasOnly([
        'id','title','note','when','contentId','mediaType','kind','createdAt','sent'
      ])
      && request.resource.data.keys().hasAll([
        'id','title','note','when','contentId','mediaType','kind','createdAt','sent'
      ])
      && request.resource.data.id is string
      && request.resource.data.id.size() <= 100
      && request.resource.data.title is string
      && request.resource.data.title.size() <= 180
      && request.resource.data.note is string
      && request.resource.data.note.size() <= 500
      && request.resource.data.when is string
      && request.resource.data.contentId is string
      && request.resource.data.contentId.matches('^[0-9]+$')
      && request.resource.data.mediaType in ['movie','tv']
      && request.resource.data.kind is string
      && request.resource.data.kind.size() <= 40
      && request.resource.data.createdAt is number
      && request.resource.data.sent is bool;
    }

    function validPreferences() {
      return request.resource.data.preferences.keys().hasOnly([
        'providerCountry','autoplayTrailers','reducedMotion'
      ])
      && request.resource.data.preferences.keys().hasAll([
        'providerCountry','autoplayTrailers','reducedMotion'
      ])
      && request.resource.data.preferences.providerCountry is string
      && request.resource.data.preferences.providerCountry.matches('^[A-Z]{2}$')
      && request.resource.data.preferences.autoplayTrailers is bool
      && request.resource.data.preferences.reducedMotion is bool;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
        'displayName','email','provider','preferences','createdAt','updatedAt'
      ])
      && (!request.resource.data.keys().hasAny(['displayName']) ||
          (request.resource.data.displayName is string &&
           request.resource.data.displayName.size() <= 100))
      && (!request.resource.data.keys().hasAny(['email']) ||
          (request.resource.data.email == null ||
           (request.resource.data.email is string &&
            request.resource.data.email.size() <= 320)))
      && (!request.resource.data.keys().hasAny(['provider']) ||
          (request.resource.data.provider is string &&
           request.resource.data.provider.size() <= 50 &&
           request.resource.data.provider in ['password', 'google.com']))
      && (!request.resource.data.keys().hasAny(['email']) ||
          request.resource.data.email == null ||
          request.resource.data.email == request.auth.token.email)
      && (!request.resource.data.keys().hasAny(['preferences']) || validPreferences())
      && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt is timestamp)
      && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is timestamp);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId) && validProfile();
      allow delete: if isOwner(userId);

      match /pushSubscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPushSubscription();
        allow delete: if isOwner(userId);
      }

      match /releaseAlerts/{alertId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow create, update: if false;
      }

      match /releaseStates/{stateId} {
        allow read, write: if false;
      }


      match /cinemaReminders/{reminderId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCinemaReminder();
        allow delete: if isOwner(userId);
      }

      match /favorites/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /watchLater/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /history/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validLibraryData();
        allow delete: if isOwner(userId);
      }

      match /progress/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validContentId(contentId) && validProgressData();
        allow delete: if isOwner(userId);
      }

      match /libraryTombstones/{tombstoneId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validTombstoneData();
        allow delete: if isOwner(userId);
      }

      match /feedback/{contentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validFeedbackData();
        allow delete: if isOwner(userId);
      }

      match /events/{eventId} {
        allow create: if isOwner(userId) && validEventData();
        allow read, update, delete: if false;
      }

      match /taste/{tasteId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && tasteId == "profile" && validTasteData();
        allow delete: if isOwner(userId);
      }
    }

    // News/community authorization is enforced here, not only in browser controls.
    function isVerifiedMember() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isModerator() {
      return signedIn() && request.auth.token.moderator == true;
    }
    function communityUserActive(userId) {
      return !exists(/databases/$(database)/documents/communityUsers/$(userId))
        || get(/databases/$(database)/documents/communityUsers/$(userId)).data.status != 'suspended';
    }
    function validCommunityTopic(topic) {
      return topic in ['film','ghana','nollywood','african','anime','theories','streaming'];
    }
    function profileNameMatches(userId, authorName) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.displayName is string
        && get(/databases/$(database)/documents/users/$(userId)).data.displayName == authorName;
    }
    function validCommunityPost() {
      return request.resource.data.keys().hasOnly(['authorId','authorName','body','topic','status','createdAt','updatedAt','commentCount'])
        && request.resource.data.keys().hasAll(['authorId','authorName','body','topic','status','createdAt','updatedAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 100
        && profileNameMatches(request.auth.uid, request.resource.data.authorName)
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 2
        && request.resource.data.body.size() <= 2000
        && validCommunityTopic(request.resource.data.topic)
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.keys().hasAny(['commentCount']) || (request.resource.data.commentCount is number && request.resource.data.commentCount == 0));
    }
    function validCommunityComment() {
      return request.resource.data.keys().hasOnly(['authorId','authorName','body','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['authorId','authorName','body','status','createdAt','updatedAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 100
        && profileNameMatches(request.auth.uid, request.resource.data.authorName)
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 1000
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /newsSources/{sourceId} {
      allow get, list: if isModerator();
      allow create, update: if isModerator()
        && request.resource.data.keys().hasOnly(['publisher','domain','status','defaultRegion','defaultCategory','feedUrl','feedApproved','imageUsageApproved','verifiedAt','verifiedBy','reviewNotes','createdAt','updatedAt'])
        && request.resource.data.publisher is string
        && request.resource.data.publisher.size() >= 2
        && request.resource.data.publisher.size() <= 120
        && request.resource.data.domain == sourceId
        && request.resource.data.status in ['approved','disabled']
        && request.resource.data.defaultRegion in ['global','ghana','nigeria','africa']
        && request.resource.data.defaultCategory in ['film-tv','streaming','celebrity','trailers','awards','box-office']
        && request.resource.data.feedUrl is string
        && request.resource.data.feedUrl.size() <= 1000
        && request.resource.data.feedApproved is bool
        && (!request.resource.data.feedApproved || (request.resource.data.feedUrl.size() > 0 && request.resource.data.feedUrl.matches('^https://[^ ]+$')))
        && request.resource.data.imageUsageApproved is bool
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.reviewNotes is string
        && request.resource.data.reviewNotes.size() >= 10
        && request.resource.data.reviewNotes.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if isModerator();
    }

    match /articles/{articleId} {
      allow get, list: if isModerator() || resource.data.status == 'published';
      allow create: if isModerator()
        && request.resource.data.status == 'published'
        && request.resource.data.keys().hasOnly(['headline','summary','body','publisher','author','sourceUrl','imageUrl','imageAlt','category','region','publishedAt','updatedAt','ingestedAt','status','correction','sourceId','canonicalUrl','topics','sourceUpdatedAt','origin','featured'])
        && request.resource.data.headline is string
        && request.resource.data.headline.size() >= 5
        && request.resource.data.headline.size() <= 240
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 700
        && (!request.resource.data.keys().hasAny(['featured']) || request.resource.data.featured is bool)
        && request.resource.data.sourceUrl is string
        && request.resource.data.sourceUrl.matches('^https://[^ ]+$')
        && request.resource.data.publisher is string
        && request.resource.data.publisher.size() <= 120
        && request.resource.data.sourceId is string
        && request.resource.data.sourceId.size() <= 200
        && exists(/databases/$(database)/documents/newsSources/$(request.resource.data.sourceId))
        && get(/databases/$(database)/documents/newsSources/$(request.resource.data.sourceId)).data.status == 'approved'
        && get(/databases/$(database)/documents/newsSources/$(request.resource.data.sourceId)).data.publisher == request.resource.data.publisher
        && request.resource.data.publishedAt is timestamp
        && request.resource.data.publishedAt <= request.time
        && request.resource.data.updatedAt is timestamp;
      allow update, delete: if isModerator();

      match /comments/{commentId} {
        allow get, list: if isModerator() || (get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published' && resource.data.status == 'published');
        allow create: if isVerifiedMember()
          && communityUserActive(request.auth.uid)
          && get(/databases/$(database)/documents/articles/$(articleId)).data.status == 'published'
          && validCommunityComment();
        allow update: if isModerator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','moderatedAt','moderationNote'])
          && request.resource.data.status in ['published','hidden']
          && request.resource.data.moderatedAt == request.time;
        allow delete: if isModerator() || (isVerifiedMember() && resource.data.authorId == request.auth.uid);
      }
    }

    match /communityPosts/{postId} {
      allow get, list: if isModerator() || resource.data.status == 'published';
      allow create: if isVerifiedMember() && communityUserActive(request.auth.uid) && validCommunityPost();
      allow update: if (isModerator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','moderatedAt','moderationNote'])
          && request.resource.data.status in ['published','hidden','locked']
          && request.resource.data.moderatedAt == request.time)
        || (isVerifiedMember()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','updatedAt'])
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.topic == resource.data.topic
          && request.resource.data.status == resource.data.status
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 2
          && request.resource.data.body.size() <= 2000
          && request.resource.data.updatedAt == request.time);
      allow delete: if isModerator() || (isVerifiedMember() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow get, list: if isModerator() || (get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published' && resource.data.status == 'published');
        allow create: if isVerifiedMember()
          && communityUserActive(request.auth.uid)
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published'
          && validCommunityComment();
        allow update: if isModerator()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','moderatedAt','moderationNote'])
          && request.resource.data.status in ['published','hidden']
          && request.resource.data.moderatedAt == request.time;
        allow delete: if isModerator() || (isVerifiedMember() && resource.data.authorId == request.auth.uid);
      }

      match /reactions/{userId} {
        allow get: if isVerifiedMember() && request.auth.uid == userId;
        allow list: if false;
        allow create: if isVerifiedMember()
          && communityUserActive(request.auth.uid)
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published'
          && request.resource.data.keys().hasOnly(['userId','type','createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.type == 'like'
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedMember() && request.auth.uid == userId;
      }
    }

    match /communityReports/{reportId} {
      allow create: if isVerifiedMember()
        && request.resource.data.keys().hasOnly(['reporterId','targetType','targetId','reason','details','status','createdAt'])
        && request.resource.data.keys().hasAll(['reporterId','targetType','targetId','reason','details','status','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post','community_comment','article_comment','user','article']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 240
        && request.resource.data.reason in ['harassment','hate','spam','spoiler','impersonation','privacy','misinformation','other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isModerator() || (isVerifiedMember() && resource.data.reporterId == request.auth.uid);
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','moderatedBy','moderatedAt','resolution'])
        && request.resource.data.status in ['open','reviewing','resolved','action_taken']
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt == request.time
        && request.resource.data.resolution is string
        && request.resource.data.resolution.size() <= 1000;
      allow delete: if false;
    }

    match /communityUsers/{userId} {
      allow get: if isModerator() || isOwner(userId);
      allow list: if isModerator();
      allow create, update: if isModerator()
        && request.resource.data.keys().hasOnly(['status','reason','updatedAt','updatedBy'])
        && request.resource.data.status in ['active','suspended']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isModerator();
    }

    match /users/{userId}/blockedUsers/{targetId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && targetId != userId
        && request.resource.data.keys().hasOnly(['targetId','createdAt'])
        && request.resource.data.targetId == targetId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/followingTopics/{topicId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isVerifiedMember()
        && communityUserActive(userId)
        && validCommunityTopic(topicId)
        && request.resource.data.keys().hasOnly(['topicId','createdAt'])
        && request.resource.data.topicId == topicId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(userId) && validCommunityTopic(topicId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
